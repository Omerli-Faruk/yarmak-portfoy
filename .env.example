# docker compose ayarları. Değiştirmek istediğiniz satırları .env dosyasına kopyalayın; hiçbiri zorunlu değil.
# Varsayılanlar yalnızca yerel geliştirme içindir.

# PostgreSQL kullanıcı adı
POSTGRES_USER=postgres
# PostgreSQL şifresi
POSTGRES_PASSWORD=postgres
# Veritabanı adı
POSTGRES_DB=yarmak

# Bilgisayarda açılacak veritabanı portu (yalnızca 127.0.0.1 üzerinden erişilir)
DB_PORT=5432
# Bilgisayarda açılacak API portu (konteyner içinde her zaman 8080)
PORT=8080
# Bilgisayarda açılacak arayüz portu
FRONTEND_PORT=3000

# JWT imzalama anahtarı; en az 32 karakter (`openssl rand -hex 32`).
# Boş bırakılırsa API her açılışta geçici bir anahtar üretir; yerel deneme için yeterli.
JWT_SECRET=
# CORS izinli kaynaklar; FRONTEND_PORT'u değiştirirseniz buraya da ekleyin
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
# Oturum çerezlerine Secure bayrağı: HTTPS arkasında true, yerelde false
COOKIE_SECURE=false
# Swagger arayüzü (http://localhost:8080/swagger/index.html); kapatmak için false
ENABLE_SWAGGER=true

# Tarayıcının kullanacağı API adresi; derleme anında arayüze gömülür, değiştirince --build gerekir
NEXT_PUBLIC_API_URL=http://localhost:8080/v1
