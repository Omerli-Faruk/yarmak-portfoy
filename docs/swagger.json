{
    "swagger": "2.0",
    "info": {
        "description": "BIST 100 hisseleri, TEFAS yatırım fonları, altın ve döviz portföy takip sistemi REST API dokümantasyonu.",
        "title": "Midas Borsa \u0026 Portföy Takip API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/v1",
    "paths": {
        "/alerts": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Kullanıcının aktif ve tetiklenmiş tüm fiyat alarmlarını listeler",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Alerts"
                ],
                "summary": "Kullanıcının Alarmlarını Listele",
                "responses": {}
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Belirli bir hisse veya fon hedef fiyata ulaştığında tetiklenecek alarm kurar",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Alerts"
                ],
                "summary": "Fiyat Alarmı Kur",
                "responses": {}
            }
        },
        "/alerts/{id}": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Kullanıcının kurduğu bir fiyat alarmını iptal eder/siler",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Alerts"
                ],
                "summary": "Fiyat Alarmını Sil",
                "responses": {}
            }
        },
        "/assets": {
            "get": {
                "description": "Sistemde kayıtlı tüm BIST hisseleri, TEFAS fonları ve altınları anlık fiyatlarıyla döner",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Assets"
                ],
                "summary": "Tüm Varlıkları Listele",
                "responses": {}
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Sisteme yeni bir hisse, fon, altın veya döviz varlığı ekler",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Assets"
                ],
                "summary": "Yeni Varlık Tanımla (Admin)",
                "responses": {}
            }
        },
        "/assets/lookup": {
            "get": {
                "description": "Sembol ve türe göre varlık arar, sistemde yoksa piyasadan anında çeker",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Assets"
                ],
                "summary": "Akıllı Varlık Arama \u0026 Keşif",
                "responses": {}
            }
        },
        "/assets/{id}/price-history": {
            "get": {
                "description": "Belirli bir varlığın tarihsel fiyat değişim geçmişini listeler",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Assets"
                ],
                "summary": "Varlık Fiyat Geçmişi",
                "responses": {}
            }
        },
        "/assets/{id}/splits": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Belirli bir hissenin geçmişte yaşadığı tüm bedelsiz bölünmeleri listeler",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Splits"
                ],
                "summary": "Hissenin Bölünme Geçmişi",
                "responses": {}
            }
        },
        "/auth/login": {
            "post": {
                "description": "Email ve şifre ile giriş yapıp JWT token üretir",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Kullanıcı Girişi",
                "responses": {}
            }
        },
        "/auth/me": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "JWT token ile doğrulanmış kullanıcının profil bilgilerini döner",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Giriş Yapmış Kullanıcı Bilgisi",
                "responses": {}
            }
        },
        "/auth/register": {
            "post": {
                "description": "Sisteme yeni bir kullanıcı kaydeder",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Yeni Kullanıcı Kaydı",
                "responses": {}
            }
        },
        "/dividends": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Kullanıcının aldığı tüm temettü ödemelerini listeler",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Dividends"
                ],
                "summary": "Kullanıcının Temettü Geçmişi",
                "responses": {}
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Kullanıcının aldığı nakit temettü ödemesini kaydeder",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Dividends"
                ],
                "summary": "Temettü Geliri Kaydet",
                "responses": {}
            }
        },
        "/dividends/{id}": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Kullanıcının kaydettiği bir temettü gelirini siler",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Dividends"
                ],
                "summary": "Temettü Kaydını Sil",
                "responses": {}
            }
        },
        "/portfolio/history": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Kullanıcının portföyünün zaman içindeki gelişimini grafik için döner",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Portfolio"
                ],
                "summary": "Portföy Tarihsel Grafik Geçmişi",
                "responses": {}
            }
        },
        "/portfolio/holdings": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Kullanıcının sahip olduğu tüm varlıkları, lot sayılarını ve kâr/zararlarını döner",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Portfolio"
                ],
                "summary": "Kullanıcının Varlıklarını (Holdings) Listele",
                "responses": {}
            }
        },
        "/portfolio/summary": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Toplam portföy değeri, toplam maliyet, kâr/zarar, dolar karşılığı ve kategori dağılımını döner",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Portfolio"
                ],
                "summary": "Portföy Özeti (TL ve Dolar)",
                "responses": {}
            }
        },
        "/splits": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Hissede bölünme uygular ve tüm kullanıcıların geçmiş işlemlerini günceller",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Splits"
                ],
                "summary": "Bedelsiz/Ters Bölünme Uygula (Admin)",
                "responses": {}
            }
        },
        "/transactions": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Kullanıcının geçmiş alım/satım işlemlerini sayfalanmış olarak listeler",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Transactions"
                ],
                "summary": "İşlem Geçmişi (Pagination)",
                "responses": {}
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Kullanıcı portföyüne yeni bir alım (BUY) veya satım (SELL) işlemi kaydeder",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Transactions"
                ],
                "summary": "Alım/Satım İşlemi Yap",
                "responses": {}
            }
        },
        "/transactions/{id}": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Kullanıcının gerçekleştirdiği bir alım veya satım işlemini siler",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Transactions"
                ],
                "summary": "Alım/Satım İşlemini Sil",
                "responses": {}
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "JWT Token'ınızı 'Bearer \u003ctoken\u003e' formatında giriniz.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}