# Uygulama Portu
PORT=8080

# Veritabanı Bağlantısı (Docker ortamı için 'db', yerel ortam için 'localhost')
DB_URL=postgres://postgres:postgres@localhost:5432/yarmak?sslmode=disable

# PostgreSQL Kimlik Bilgileri (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yarmak
DB_PORT=5432

# Güvenlik & Token Ayarları (En az 32 karakter olmalıdır)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# CORS İzinli Kaynaklar (Virgülle ayrılmış frontend adresleri)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Rate limit için X-Real-IP başlığına güvenilecek adresler (virgülle ayrılmış CIDR).
# Buraya yalnızca Next.js sunucusunun backend'e bağlandığı adresi yazın. Boş bırakılırsa sadece 127.0.0.1 ve ::1 güvenilir.
# Docker port yönlendirmesinde dışarıdan gelen istekler de ağ geçidi adresinden görünebilir; o adresi eklemek başlığı herkese açar.
TRUSTED_PROXIES=127.0.0.1/32,::1/128
