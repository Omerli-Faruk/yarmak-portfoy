# Uygulama Portu
PORT=8080

# Veritabanı Bağlantısı (Docker ortamı için 'db', yerel ortam için 'localhost')
DB_URL=postgres://postgres:postgres@localhost:5432/stock_portfolio?sslmode=disable

# PostgreSQL Kimlik Bilgileri (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stock_portfolio
DB_PORT=5432

# Güvenlik & Token Ayarları (En az 32 karakter olmalıdır)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# CORS İzinli Kaynaklar (Virgülle ayrılmış frontend adresleri)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
