# Backend'i Docker dışında (go run .) çalıştırırken kullanılan ayarlar. Bu dosyayı .env olarak kopyalayın.
# Docker Compose ayarları için kök dizindeki .env.example'a bakın.

# API'nin dinleyeceği port
PORT=8080

# PostgreSQL bağlantı adresi (Docker içinde host 'db', yerelde 'localhost')
DB_URL=postgres://postgres:postgres@localhost:5432/yarmak?sslmode=disable

# JWT imzalama anahtarı; en az 32 karakter (`openssl rand -hex 32`).
# Boş bırakılırsa her açılışta geçici bir anahtar üretilir; yerel deneme için yeterli.
JWT_SECRET=

# CORS izinli kaynaklar (virgülle ayrılmış frontend adresleri)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Rate limit için X-Real-IP başlığına güvenilecek adresler (virgülle ayrılmış CIDR); boşsa yalnızca 127.0.0.1 ve ::1.
# Buraya yalnızca Next.js sunucusunun backend'e bağlandığı adresi yazın. Docker ağ geçidi adresini eklemek başlığı herkese açar.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Oturum çerezlerine Secure bayrağı: HTTPS arkasında true, yerelde (http://localhost) false
COOKIE_SECURE=false

# Swagger arayüzü (/swagger/index.html); kapatmak için false
ENABLE_SWAGGER=true

# Yalnızca cmd/tefas_deep_seeder: true ise mevcut kayıtlara bakmadan 5 yıllık fon geçmişini baştan çeker
FORCE_FULL_BACKFILL=false
